@article{sanchez_evaluation_2008,
  title = {Evaluation of Surface Ozone Measurements during 2000-2005 at a Rural Area in the Upper {{Spanish}} Plateau},
  author = {family=Sánchez, given=ML, given-i=ML and family=García, given=MA, given-i=MA and family=Pérez, given=IA, given-i=IA and family=Torre, given=B, prefix=de, useprefix=true},
  date = {2008-06},
  journaltitle = {Journal of Atmospheric Chemistry},
  volume = {60},
  number = {2},
  pages = {137--152},
  issn = {0167-7764},
  doi = {10.1007/s10874-008-9113-2},
  abstract = {This paper presents the main experimental results of surface ozone concentrations measured at a rural area in Northern Spain from February 2000 to December 2005. Daily and seasonal variation of ozone has been analysed. The peak concentration levels are obtained in the afternoon, mean value around 88 A mu g m(-3), with extreme average values of 59 A mu g m(-3) in January and 113 A mu g m(-3) in July. Small differences are found in the mean and median of the ozone levels from April to August, when spring and summer maxima are observed. Despite the great inter-annual ozone variability obtained, most air quality indicators showed a positive trend. Further analysis of the monthly mean ozone concentrations of the main percentiles have also been performed using a harmonic model. The upward trend was 6.2 A +/- 1.7 A mu g m(-3) for the 98th percentile. To interpret the main features of the annual cycle and describe the ozone peaks, the influence of meteorological factors is studied. In summer, ozone production is governed by local processes, air temperature being the major controlling factor. However, the origin of the spring maximum is not so well identified.},
  keywords = {\nosource,Air quality,Atmospheric temperature,EUROPE,Meteorology,METEOROLOGY,Northern Spain,nosource,Ozone formation,Ozone trend,Plateaus,POLLUTION,Rural geography,Rural site,Seasonal variation,Spain,STATION,TRENDS,TROPOSPHERE,Tropospheric ozone,URBAN AREA}
}

