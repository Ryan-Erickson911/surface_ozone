@article{miki_enhanced_2024,
  title = {Enhanced {{O3}} Concentration Due to Biogenic Emissions during a Hot Summer in 2018 over the {{Tokyo}} Metropolitan Area, {{Japan}}},
  author = {Miki, K and Itahashi, S},
  date = {2024-10},
  journaltitle = {ENVIRONMENTAL RESEARCH COMMUNICATIONS},
  volume = {6},
  number = {10},
  issn = {2515-7620},
  doi = {10.1088/2515-7620/ad8399},
  abstract = {Photochemical ozone (O-3) is an important chemical component in the atmosphere as an indicator of air pollution. Anthropogenic sources, such as domestic automobiles and industries, have been considered a main source of O-3 especially in urban areas; however, recent emission regulations have led to declining trends in anthropogenic sources. Therefore, other sources, such as biogenic emissions, could be important in the near future. In addition, increasing temperatures caused by global warming will relate to increasing biogenic emissions. In this study, the role of biogenic volatile organic compounds (BVOC) on O-3 concentration was focused. The target period was a hot summer in 2018 in Japan, and O-3 concentration by simulating with and without biogenic emissions over the Tokyo metropolitan area was analyzed. The result clarified that around 20\% (up to 63\%) of O(3)was produced from biogenic sources at high temperatures, even in the Tokyo metropolitan area. This study suggested that the biogenic sources should be paid attention to and taken into account in the regulation of anthropogenic emissions.},
  keywords = {\nosource,AIR-QUALITY,biogenic volatile organic compounds (BVOC),CHEMISTRY,CLIMATE,CMAQ,EAST-ASIA,hot summer,IMPACT,MODEL EVALUATION,ozone (O-3),Tokyo metropolitan area,TRENDS,TROPOSPHERIC OZONE}
}

@article{milczewska_investigating_2019,
  title = {Investigating the Influence of Boundary Layer Entrainment on Surface Ozone Concentrations within an Air Quality Forecast.},
  author = {Milczewska, Kaja and Dacre, Helen and Agnew, Paul and Neal, Lucy and Mittermaier, Marion},
  date = {2019-01},
  journaltitle = {Geophysical Research Abstracts},
  volume = {21},
  pages = {1--1},
  issn = {1029-7006},
  url = {https://research.ebsco.com/linkprocessor/plink?id=60acd7dd-47f7-34e1-992d-5cb68d52f49d},
  abstract = {Correctly forecasting regional surface concentrations of pollutants is important to public health, as exposure to elevated concentrations may trigger respiratory problems.This study aims to determine the extent to which surface ozone forecasts are dependent on the representation of boundary layer processes. We evaluate UK-wide hourly ozone forecasts within Met Office Air Quality configuration of the Unified Model (AQUM), using routine ground-level measurements taken during June 2017. AQUM captures the timing of daytime peak in ozone concentrations, with a 2-hour lag in the morning increase. This suggests that the delayed onset of the boundary layer growth is related to subsequent mixing of ozone-rich air from the night-time residual layer to surface.Presented are results from a semi-idealised configuration the Numerical Atmospheric-dispersion Modelling Environment (NAME), where a novel tagging mechanism enables the partitioning of particles' sources and trajectories, thus quantifying the influence of entrainment into the boundary layer on near-surface ozone concentrations.},
  language = {eng},
  keywords = {\nosource,Air quality,Boundary layer (Aerodynamics),Great Britain. Meteorological Office,Ozone,Ozone layer,Pollutants,Tropospheric ozone}
}

