  author = {Fania, A and Monaco, A and Amoroso, N and Bellantuono, L and family=Gatti, given=RC, given-i=RC and Firza, N and Lacalamita, A and Pantaleo, E and Tangaro, S and Velichevskaya, A and Bellotti, R},
  date = {2024-03},
  journaltitle = {Scientific Reports},
  volume = {14},
