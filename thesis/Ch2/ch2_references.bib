@article{cai_oxidative_2022,
  title = {Oxidative Digestion of Dissolved {{N-compounds}} by the {{UV}}/{{O3}} Process: {{Kinetic}} Models and Rate Constants},
  author = {family=Cai, given=RY, given-i=RY and family=Shou, given=WQ, given-i=WQ and family=Lai, given=SB, given-i=SB and family=Chen, given=HX, given-i=HX and family=Liu, given=ZY, given-i=ZY and family=Zhou, given=MF, given-i=MF and family=Sun, given=XF, given-i=XF},
  date = {2022-12},
  journaltitle = {INTERNATIONAL JOURNAL OF CHEMICAL KINETICS},
  volume = {54},
  number = {12},
  pages = {692--701},
  issn = {0538-8066},
  doi = {10.1002/kin.21606},
  abstract = {In this study, the reaction mechanisms and kinetic of UV/O-3 digestion processes were explored with ammonium chloride and urea as the target pollutants, focused on the ozone direct oxidation and hydroxyl radical oxidation parts. Under the conditions of dual environmental digestion method, two kinds of kinetic models were proposed by competitive kinetic method with R-ct based on the different scale of rate constants of hydroxyl radical oxidation. Subsequently, the second-order rate constants of ammonia (pH 11) and urea (pH 2) was determined to be 4.613 +/- 0.094 and 0.378 +/- 0.006 M-1 s(-1) by ozone direct oxidation, and (6.154 +/- 0.971) x 10(7) and (2.257 +/- 0.513) x 10(6) M-1 s(-1) by hydroxyl radical oxidation, respectively. Compared with contribution level of two parts to the digestion process, it was shown that in the digestion of ammonia, ozone and center dot OH radical contribute equally (58.86\%, 41.14\%). In contrast, in the case of urea, ozone (86.10\%) contributes more than center dot OH radical.},
  keywords = {\nosource,AOPs,AZO DYES,competitive dynamics,DEGRADATION,DRINKING-WATER,HYDROXYL,kinetic models,MECHANISMS,N-compounds,O-3,ORGANIC-COMPOUNDS,OZONATION,rate constants,SULFAMETHOXAZOLE,TOTAL NITROGEN,UV}
}


@article{cao_using_2024,
  title = {Using Complex Systems Theory to Comprehend the Coordinated Control Effects of {{PM2}}.5 and {{O3}} in {{Yangtze River Delta}} Industrial Base in {{China}}},
  author = {family=Cao, given=RH, given-i=RH and family=Xiao, given=YX, given-i=YX and family=Dong, given=YB, given-i=YB and family=Zhang, given=FW, given-i=FW and Shi, K and family=Wang, given=ZY, given-i=ZY},
  date = {2024-10},
  journaltitle = {Stochastic Environmental Research and Risk Assessment},
  volume = {38},
